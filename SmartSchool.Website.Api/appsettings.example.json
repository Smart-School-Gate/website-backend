{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-host;Port=5432;Database=smart_school_website;Username=your_username;Password=your_password;SslMode=Require"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://sms.rootaca.com",
      "https://your-frontend-domain.com"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Swagger": {
    "Enabled": false
  }
}
